{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "server.ts", "server-config.ts", "editorial-api.ts", "editorial-worker.ts", "mail-ingest.ts", "order-export-api.ts", "src/passageCatalog.ts", "src/editorial-versioning.ts", "src/order-filters.ts"]
}
